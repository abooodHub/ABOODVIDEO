# ==============================================================================
# ABOODVIDEO Platform Configuration Environment Template
# Production-ready, secure defaults. Copy to .env and change credentials!
# ==============================================================================

# Project & Environment. Supply deployment-specific values outside source control.
# Empty secrets intentionally prevent startup until secure values are configured.
PROJECT_NAME="ABOODVIDEO"
ENVIRONMENT="production"
DEBUG=false
API_V1_STR="/api/v1"
COMPOSE_PROFILES="default,backend"
SECRET_KEY=""
IP_PRIVACY_SALT=""

# Network security: LAN permits HTTP; public requires HTTPS, secure cookies,
# and redirects cleartext HTTP to HTTPS. Do not enable public mode until TLS is valid.
SECURITY_MODE="lan"
DOMAIN="localhost"
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost"
PUBLIC_BASE_URL="http://localhost"
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
TRUSTED_PROXIES="127.0.0.1,::1"

# Web Server & Concurrency (Rule 1: default to 1 on 2 vCPU server)
WEB_CONCURRENCY=1
PORT=8000
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
REDIS_POOL_MAX_CONNECTIONS=20

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_DB="aboodvideo_db"
POSTGRES_USER="aboodvideo_user"
POSTGRES_PASSWORD=""
DATABASE_URL=""
DATABASE_URL_SYNC=""

# Redis Logical Separation (Rule 6: DB 0 for Queue, DB 1 for Sessions, DB 2 for Cache/RateLimit)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_QUEUE_URL="redis://localhost:6379/0"
REDIS_SESSION_URL="redis://localhost:6379/1"
REDIS_CACHE_URL="redis://localhost:6379/2"

# Storage Configuration & Disk Thresholds (Rule 5)
STORAGE_BASE_PATH="/app/storage"
STORAGE_UPLOADS_PATH="/app/storage/uploads"
STORAGE_VIDEOS_PATH="/app/storage/videos"
STORAGE_TEMP_PATH="/app/storage/temp"
UPLOAD_INACTIVITY_TIMEOUT_SECONDS=3600

# Storage Safety Thresholds (Bytes and Percentages)
STORAGE_MIN_FREE_BYTES=5368709120       # 5 GB hard floor
STORAGE_SOFT_THRESHOLD_PERCENT=85.0     # 85% disk usage triggers warning
STORAGE_HARD_THRESHOLD_PERCENT=95.0     # 95% disk usage blocks uploads and marks storage unhealthy
MAX_UPLOAD_SIZE_BYTES=10737418240       # 10 GB max upload size
MAX_ACTIVE_UPLOADS_PER_USER=0          # Set 1..8 to cap source-upload reservations per owner

# Transcoding & Worker Settings (Rule 11)
# Full platform: true/false. Ready-import host: false/true (see docs/DEPLOYMENT_MODES.md).
ENABLE_TRANSCODING=true
ENABLE_DIRECT_IMPORT=false
DIRECT_IMPORT_MAX_BYTES=2147483648
TRANSCODE_CONCURRENCY=1
FFMPEG_PRESET="veryfast"
TRANSCODE_JOB_TIMEOUT_SECONDS=43200
ENABLE_4K_TRANSCODING=true             # Deployment safety gate; select active qualities in Admin Settings
DELETE_SOURCE_AFTER_SUCCESS=false

# Security & Tokens
SESSION_COOKIE_NAME="aboodvideo_session"
SESSION_MAX_AGE_SECONDS=604800          # 7 days
SIGNED_URL_TTL_SECONDS=300              # 5 minutes for video token URLs

# VIP & Free Tier Quality Limits
FREE_MAX_QUALITY="720p"
VIP_MAX_QUALITY="1080p"

# Optional WordPress signed private-media delivery. Leave empty unless configured.
WP_PRIVATE_MEDIA_KEY_ID=""
WP_PRIVATE_MEDIA_HMAC_KEY=""
WP_PRIVATE_MEDIA_HMAC_KEYS_JSON=""
WP_PRIVATE_MEDIA_ALLOWED_ORIGIN=""
# Optional read-only server-side ready-media mount. Never point at system directories.
ABV_IMPORT_PATH="/app/import"
